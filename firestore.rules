rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    /** True if the requesting user is authenticated */
    function isAuth() {
      return request.auth != null;
    }

    /** True if the requesting user owns the document (doc ID == uid) */
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /** True if the requesting user is the provider for this resource */
    function isProvider(providerId) {
      return isAuth() && request.auth.uid == providerId;
    }

    /** True if the requesting user is the customer for this resource */
    function isCustomer(customerId) {
      return isAuth() && request.auth.uid == customerId;
    }

    // ── providers/{providerId} ─────────────────────────────────────────────
    match /providers/{providerId} {
      allow read:   if isOwner(providerId);
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId);
      allow delete: if false; // never delete via client
    }

    // ── customers/{customerId} ─────────────────────────────────────────────
    match /customers/{customerId} {
      // Provider can read/write their own customers
      allow read:   if isAuth() &&
                       (isOwner(customerId) ||
                        isProvider(resource.data.providerId));
      allow create: if isAuth(); // provider creates directly or via join approval
      allow update: if isAuth() &&
                       (isOwner(customerId) ||
                        isProvider(resource.data.providerId));
      allow delete: if isAuth() && isProvider(resource.data.providerId);
    }

    // ── deliveries/{deliveryId} ────────────────────────────────────────────
    match /deliveries/{deliveryId} {
      allow read:   if isAuth() &&
                       (isProvider(resource.data.providerId) ||
                        isCustomer(resource.data.customerId));
      allow write:  if isAuth() && isProvider(request.resource.data.providerId);
    }

    // ── bills/{billId} ─────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read:   if isAuth() &&
                       (isProvider(resource.data.providerId) ||
                        isCustomer(resource.data.customerId));
      allow write:  if isAuth() && isProvider(request.resource.data.providerId);
    }

    // ── queries/{queryId} ─────────────────────────────────────────────────
    match /queries/{queryId} {
      // Customer can create and read their own queries
      allow create: if isAuth() && isCustomer(request.resource.data.customerId);
      allow read:   if isAuth() &&
                       (isProvider(resource.data.providerId) ||
                        isCustomer(resource.data.customerId));
      // Provider can update (reply to) queries
      allow update: if isAuth() && isProvider(resource.data.providerId);
      allow delete: if false;
    }

    // ── joinRequests/{requestId} ───────────────────────────────────────────
    match /joinRequests/{requestId} {
      // Customer creates a join request
      allow create: if isAuth() && isCustomer(request.resource.data.customerId);
      // Customer can read their own request; provider can read requests sent to them
      allow read:   if isAuth() &&
                       (isCustomer(resource.data.customerId) ||
                        isProvider(resource.data.providerId));
      // Provider approves or rejects
      allow update: if isAuth() && isProvider(resource.data.providerId);
      allow delete: if false;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
